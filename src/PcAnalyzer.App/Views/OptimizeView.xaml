<UserControl x:Class="PcAnalyzer.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PcAnalyzer.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,0,40,36">
            <TextBlock Text="Оптимизация" FontSize="16" FontWeight="Medium" Margin="0,0,0,40"/>
            <Grid Margin="0,0,0,24">
                <StackPanel Margin="0,0,320,0">
                    <TextBlock Text="Настройки Windows для игр" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Проверка параметров системы, которые влияют на FPS и фризы. Изменения безопасны, не требуют прав администратора, и любое из них можно вернуть."/>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource Ghost}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource IconRefresh}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Проверить снова"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Primary}" Command="{Binding FixAllCommand}" Visibility="{Binding HasFixable, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource IconBolt}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Исправить всё"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border CornerRadius="14" Background="{StaticResource RaisedBrush}" Padding="16,12" Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="Проверка…" Style="{StaticResource Muted}" Visibility="{Binding Loading, Converter={StaticResource Visible}}" Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="bar" CornerRadius="22,0,0,22" Background="{StaticResource MutedBrush}"/>
                                <StackPanel Grid.Column="1" Margin="24,18,16,18">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="17"/>
                                        <Border Style="{StaticResource Pill}" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="state" Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" FontWeight="Medium" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <Button Style="{StaticResource Ghost}" Content="Вернуть" Margin="0,0,8,0" Command="{Binding UndoCommand}"
                                            ToolTip="Вернуть значение, которое было до изменения приложением"
                                            Visibility="{Binding CanUndo, Converter={StaticResource Visible}}"/>
                                    <Button Style="{StaticResource Ghost}" Content="{Binding OpenLabel}" Margin="0,0,8,0" Command="{Binding OpenCommand}"
                                            Visibility="{Binding HasOpen, Converter={StaticResource Visible}}"/>
                                    <Button Style="{StaticResource Primary}" Content="{Binding FixLabel}" Command="{Binding FixCommand}"
                                            Visibility="{Binding HasFix, Converter={StaticResource Visible}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                <Setter TargetName="bar" Property="Background" Value="{StaticResource GoodBrush}"/>
                                <Setter TargetName="state" Property="Foreground" Value="{StaticResource GoodBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                <Setter TargetName="bar" Property="Background" Value="{StaticResource WarnBrush}"/>
                                <Setter TargetName="state" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
