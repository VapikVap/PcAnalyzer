<UserControl x:Class="PcAnalyzer.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PcAnalyzer.App.Controls"
             xmlns:v="clr-namespace:PcAnalyzer.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,0,40,36">
            <TextBlock Text="Главная" FontSize="16" FontWeight="Medium" Margin="0,0,0,40"/>

            <!-- Header -->
            <Grid Margin="0,0,0,36">
                <StackPanel>
                    <TextBlock Text="С возвращением!" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding ActivityText}" Style="{StaticResource Body}" FontSize="16" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Ghost}" Command="{Binding GoToCommand}" CommandParameter="Session" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Игровая сессия"/>
                            <c:IconView Data="{StaticResource IconChevronRight}" Width="14" Height="14" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Command="{Binding GoToCommand}" CommandParameter="MyPc">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Мой ПК"/>
                            <c:IconView Data="{StaticResource IconChevronRight}" Width="14" Height="14" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Health + gauges -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="310"/>
                    <RowDefinition Height="310"/>
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2" Style="{StaticResource Card}" Margin="0,0,20,0" Padding="20,28" ToolTip="{Binding Live.HealthDetails}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <c:IconView Data="{StaticResource IconHeart}" Width="20" Height="20" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Состояние" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Pill}" HorizontalAlignment="Center" Margin="0,16,0,26" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding Live.HealthBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Live.HealthLabel}" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2" HorizontalAlignment="Center">
                            <c:HealthBar Value="{Binding Live.HealthScore}" Width="80"/>
                            <TextBlock Text="{Binding Live.HealthScore, StringFormat={}{0:0} %, TargetNullValue=—}" FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,-28,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <v:GaugeCard Grid.Column="1" Margin="0,0,10,10" Icon="{StaticResource IconCpu}" Title="CPU" Subtitle="{Binding Live.CpuName}"
                             Data="{Binding Cpu}" Command="{Binding GoToCommand}" CommandParameter="MyPc"/>
                <v:GaugeCard Grid.Column="2" Margin="10,0,0,10" Icon="{StaticResource IconGpu}" Title="GPU" Subtitle="{Binding Live.GpuName}"
                             Data="{Binding Gpu}" Command="{Binding GoToCommand}" CommandParameter="MyPc"/>
                <v:GaugeCard Grid.Column="1" Grid.Row="1" Margin="0,10,10,0" Icon="{StaticResource IconBolt}" Title="RAM" Subtitle="{Binding Live.RamName}"
                             Data="{Binding Ram}" Command="{Binding GoToCommand}" CommandParameter="MyPc"/>
                <v:GaugeCard Grid.Column="2" Grid.Row="1" Margin="10,10,0,0" Icon="{StaticResource IconDatabase}" Title="VRAM" Subtitle="Видеопамять"
                             Data="{Binding Vram}" Command="{Binding GoToCommand}" CommandParameter="MyPc"/>
            </Grid>

            <!-- Live charts -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Нагрузка" Style="{StaticResource H3}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="{Binding Live.GpuLoad.Brush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Live.Sample.GpuLoad, StringFormat=GPU {0:0}%, TargetNullValue=GPU —}" Style="{StaticResource Muted}" Margin="0,0,14,0"/>
                                <Ellipse Width="8" Height="8" Fill="{Binding Live.CpuLoad.Brush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Live.Sample.CpuLoad, StringFormat=CPU {0:0}%, TargetNullValue=CPU —}" Style="{StaticResource Muted}" Margin="0,0,14,0"/>
                                <Ellipse Width="8" Height="8" Fill="{Binding Live.CpuMaxCore.Brush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Live.Sample.CpuMaxCoreLoad, StringFormat=Макс. ядро {0:0}%, TargetNullValue=Ядро —}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Grid>
                        <c:LiveChart Series="{Binding Live.LoadChart}" MaxValue="100" Height="170" Margin="0,16,0,0" Smooth="{Binding Live.Smooth}"/>
                        <!-- Per-core bars -->
                        <ItemsControl ItemsSource="{Binding Live.Cores}" Margin="34,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0" ToolTip="{Binding Load, StringFormat=Поток {0:0}%}">
                                        <Border Height="34" CornerRadius="4" Background="#14FFFFFF" VerticalAlignment="Bottom">
                                            <Border CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"
                                                    Height="{Binding Load, Converter={x:Static v:DashboardView.LoadToHeight}}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Загрузка по потокам процессора" Style="{StaticResource Muted}" FontSize="12" Margin="34,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="FPS и время кадра" Style="{StaticResource H3}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding Live.HasFps, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Live.Sample.Fps, StringFormat={}{0:0} FPS}" Style="{StaticResource Muted}" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Live.Sample.FrameTimeAvgMs, StringFormat={}{0:0.0} мс}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Height="246" Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <c:LiveChart Series="{Binding Live.FpsChart}" Smooth="{Binding Live.Smooth}"/>
                            <c:LiveChart Grid.Row="1" Series="{Binding Live.FrameChart}" Smooth="False" Fill="False" Margin="0,8,0,0"/>
                            <Border Grid.RowSpan="2" Background="#E6101116" CornerRadius="14" Visibility="{Binding Live.HasFps, Converter={StaticResource Hidden}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                    <c:IconView Data="{StaticResource IconActivity}" Width="28" Height="28" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Нет данных о кадрах" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                                    <TextBlock Text="{Binding Live.FrameSourceStatus}" Style="{StaticResource Muted}" TextAlignment="Center"/>
                                    <Button Content="Настроить источник FPS" Style="{StaticResource Ghost}" HorizontalAlignment="Center" Margin="0,14,0,0"
                                            Command="{Binding GoToCommand}" CommandParameter="Settings"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick actions -->
            <UniformGrid Columns="2" Margin="-10,30,-10,0">
                <Button Style="{StaticResource CardButton}" Margin="10" Command="{Binding GoToCommand}" CommandParameter="Session">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource IconRecord}" Width="24" Height="24" Margin="0,0,24,0"/>
                            <StackPanel>
                                <TextBlock Text="Игровая сессия" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Запись, live-графики и события" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource RaisedBrush}" HorizontalAlignment="Right">
                            <c:IconView Data="{StaticResource IconChevronRight}" Width="16" Height="16"/>
                        </Border>
                    </Grid>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="10" Command="{Binding OpenLastCommand}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource IconAnalyze}" Width="24" Height="24" Margin="0,0,24,0"/>
                            <StackPanel MaxWidth="440">
                                <TextBlock Text="Анализ последней игры" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LastSessionText, TargetNullValue=Записанных сессий пока нет}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource RaisedBrush}" HorizontalAlignment="Right">
                            <c:IconView Data="{StaticResource IconChevronRight}" Width="16" Height="16"/>
                        </Border>
                    </Grid>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="10" Command="{Binding GoToCommand}" CommandParameter="History">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource IconCompare}" Width="24" Height="24" Margin="0,0,24,0"/>
                            <StackPanel>
                                <TextBlock Text="История и сравнение" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Стало ли лучше после изменения настроек" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource RaisedBrush}" HorizontalAlignment="Right">
                            <c:IconView Data="{StaticResource IconChevronRight}" Width="16" Height="16"/>
                        </Border>
                    </Grid>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="10" Command="{Binding GoToCommand}" CommandParameter="MyPc">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource IconPc}" Width="24" Height="24" Margin="0,0,24,0"/>
                            <StackPanel>
                                <TextBlock Text="Мой ПК" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Железо, драйверы, монитор, источники данных" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource RaisedBrush}" HorizontalAlignment="Right">
                            <c:IconView Data="{StaticResource IconChevronRight}" Width="16" Height="16"/>
                        </Border>
                    </Grid>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
