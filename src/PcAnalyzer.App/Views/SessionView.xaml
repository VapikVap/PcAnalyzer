<UserControl x:Class="PcAnalyzer.App.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PcAnalyzer.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,0,40,36">
            <TextBlock Text="Игровая сессия" FontSize="16" FontWeight="Medium" Margin="0,0,0,40"/>
            <Grid Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="Запись игровой сессии" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding ModeText}" Style="{StaticResource Body}" Margin="0,8,0,0" MaxWidth="820" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Pill}" Background="#1A3D74FF" Padding="16,10" Margin="0,0,0,16" HorizontalAlignment="Left"
                    Visibility="{Binding StatusMessage, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Control card -->
                <Border Style="{StaticResource Card}" Background="{StaticResource HeroBrush}" Margin="0,0,10,0" Padding="30">
                    <Grid>
                        <!-- Recording -->
                        <StackPanel Visibility="{Binding IsRecording, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Fill="{StaticResource BadBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ИДЁТ ЗАПИСЬ" FontWeight="Bold" Foreground="{StaticResource BadBrush}" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Elapsed}" FontFamily="{StaticResource DisplayFont}" FontSize="64" FontWeight="SemiBold" Margin="0,8,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Название игры" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Метка (для сравнения «до / после»)" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding LabelPresets}" SelectedItem="{Binding Label}"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="Сохранить" Margin="12,0,0,0" VerticalAlignment="Bottom" Command="{Binding SaveNameCommand}"
                                        IsEnabled="{Binding CanControl}"/>
                            </Grid>
                            <Button Style="{StaticResource Danger}" HorizontalAlignment="Left" Margin="0,24,0,0" Padding="26,12" Command="{Binding StopCommand}"
                                    ToolTip="Сохранить сессию и сформировать отчёт">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconView Data="{StaticResource IconStop}" Width="16" Height="16" Filled="True" Foreground="#FFB3B6" Margin="0,0,10,0"/>
                                    <TextBlock Text="Завершить запись и проанализировать"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Idle -->
                        <StackPanel Visibility="{Binding IsRecording, Converter={StaticResource Hidden}}">
                            <TextBlock Text="Обнаруженная игра" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding DetectedText}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,6,0,24"/>

                            <TextBlock Text="Начать запись вручную" Style="{StaticResource H3}" Margin="0,0,0,12"/>
                            <Grid IsEnabled="{Binding CanControl}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Приложение (для FPS и показателей игры)" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                <ComboBox Grid.Row="1" ItemsSource="{Binding RunningApps}" SelectedItem="{Binding SelectedApp}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding ExeName, StringFormat='  ·  {0}'}" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundIcon}" Margin="10,0,0,0" ToolTip="Обновить список" Command="{Binding RefreshAppsCommand}">
                                    <c:IconView Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Grid.Row="2" Text="Название сессии" Style="{StaticResource Muted}" Margin="0,14,0,6"/>
                                <TextBox Grid.Row="3" Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Button Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,24,0,0" Padding="26,12" Command="{Binding StartCommand}"
                                    IsEnabled="{Binding CanControl}">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconView Data="{StaticResource IconRecord}" Width="16" Height="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="Начать запись"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sources -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Источники данных" Style="{StaticResource H3}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{Binding Available, Converter={StaticResource SourceBrush}}" Margin="0,6,12,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border CornerRadius="14" Background="#14FFB547" Padding="14" Margin="0,6,0,0" Visibility="{Binding IsElevated, Converter={StaticResource Hidden}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Приложение запущено без прав администратора. Температура CPU и запись FPS через PresentMon требуют повышенных прав."/>
                                <Button Content="Перезапустить от администратора" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding RestartElevatedCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live charts -->
            <UniformGrid Columns="2" Margin="-10,10,-10,0">
                <Border Style="{StaticResource Card}" Margin="10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="FPS" Style="{StaticResource H3}"/>
                            <TextBlock Text="{Binding Live.Sample.Fps, StringFormat={}{0:0}, TargetNullValue=нет данных}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <c:LiveChart Series="{Binding Live.FpsChart}" Height="160" Margin="0,12,0,0" Smooth="{Binding Live.Smooth}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Время кадра (макс. / сред.), мс" Style="{StaticResource H3}"/>
                            <TextBlock Text="{Binding Live.Sample.FrameTimeMaxMs, StringFormat=макс {0:0.0} мс, TargetNullValue=нет данных}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <c:LiveChart Series="{Binding Live.FrameChart}" Height="160" Margin="0,12,0,0" Smooth="False" Fill="False"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Загрузка GPU / CPU / макс. ядро, %" Style="{StaticResource H3}"/>
                        </Grid>
                        <c:LiveChart Series="{Binding Live.LoadChart}" MaxValue="100" Height="160" Margin="0,12,0,0" Smooth="{Binding Live.Smooth}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Температуры GPU / CPU, °C" Style="{StaticResource H3}"/>
                        </Grid>
                        <c:LiveChart Series="{Binding Live.TempChart}" Height="160" Margin="0,12,0,0" Smooth="{Binding Live.Smooth}" Fill="False"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Events -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="События текущей сессии" Style="{StaticResource H3}" Margin="0,0,0,12"/>
                    <TextBlock Text="Пока ничего не обнаружено. Просадки FPS, фризы, перегрев и переполнение памяти появятся здесь во время записи."
                               Style="{StaticResource Muted}" Visibility="{Binding Events.Count, Converter={StaticResource Hidden}}"/>
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}"/>
                                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Kind}" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
