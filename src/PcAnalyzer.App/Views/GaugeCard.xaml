<UserControl x:Class="PcAnalyzer.App.Views.GaugeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PcAnalyzer.App.Controls"
             x:Name="Self">
    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
        <Grid>
            <Grid Margin="28,28,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="1" Fill="{StaticResource CardGlowBrush}" Margin="0,0,-20,0" IsHitTestVisible="False"/>

                <!-- Left: identity -->
                <Grid Margin="0,0,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Tile}" HorizontalAlignment="Left">
                        <c:IconView Data="{Binding Icon, ElementName=Self}" Width="24" Height="24" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,12,0,16" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Title, ElementName=Self}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Subtitle, ElementName=Self}" Style="{StaticResource Body}" FontSize="15" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Data.Details, ElementName=Self}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Row="2" HorizontalAlignment="Left" Content="Подробнее" Style="{StaticResource Ghost}" Background="#0CFFFFFF"
                            Command="{Binding Command, ElementName=Self}" CommandParameter="{Binding CommandParameter, ElementName=Self}"/>
                </Grid>

                <!-- Right: gauge -->
                <Viewbox Grid.Column="1" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,20" MaxHeight="250">
                <Grid Width="300" Height="240">
                    <c:RadialGauge Value="{Binding Data.Value, ElementName=Self}" Maximum="{Binding Data.Maximum, ElementName=Self}"
                                   WarnFrom="{Binding Data.WarnFrom, ElementName=Self}"/>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,98,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Data.ValueText, ElementName=Self}" Style="{StaticResource BigNumber}"/>
                            <TextBlock Text="{Binding Data.Unit, ElementName=Self}" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,10,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Data.Caption, ElementName=Self}" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                    </StackPanel>
                </Grid>
                </Viewbox>
            </Grid>
        </Grid>
    </Border>
</UserControl>
