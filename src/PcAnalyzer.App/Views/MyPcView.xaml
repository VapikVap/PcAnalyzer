<UserControl x:Class="PcAnalyzer.App.Views.MyPcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PcAnalyzer.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,0,40,36">
            <TextBlock Text="Мой ПК" FontSize="16" FontWeight="Medium" Margin="0,0,0,40"/>
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Конфигурация компьютера" Style="{StaticResource H1}"/>
                    <TextBlock Text="Сведения из Windows (WMI, реестр, параметры дисплея). Снимок конфигурации сохраняется с каждой сессией." Style="{StaticResource Body}" Margin="0,8,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Data="{StaticResource IconRefresh}" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Обновить"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="Сбор сведений…" Style="{StaticResource Muted}" Visibility="{Binding Loading, Converter={StaticResource Visible}}" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BadBrush}" Visibility="{Binding StatusMessage, Converter={StaticResource Visible}}" Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding Sections}" Margin="-10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource Tile}" Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0">
                                        <c:IconView Data="{Binding Icon}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="18" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Доступность показателей на этом ПК" Style="{StaticResource H3}" FontSize="18" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="340"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{Binding Available, Converter={StaticResource SourceBrush}}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Muted}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
