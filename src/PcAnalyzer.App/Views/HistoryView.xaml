<UserControl x:Class="PcAnalyzer.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PcAnalyzer.App.Controls"
             x:Name="Self">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,0,40,36">
            <TextBlock Text="История" FontSize="16" FontWeight="Medium" Margin="0,0,0,40"/>
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Игровые сессии" Style="{StaticResource H1}"/>
                    <TextBlock Text="Отметьте две сессии одной игры, чтобы проверить, дали ли изменения настроек результат." Style="{StaticResource Body}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <ComboBox Width="260" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource Primary}" Command="{Binding CompareCommand}">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource IconCompare}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SelectedCount, StringFormat=Сравнить ({0}/2)}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Pill}" Background="#1A3D74FF" Padding="16,10" Margin="0,0,0,16" HorizontalAlignment="Left"
                    Visibility="{Binding StatusMessage, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding StatusMessage}"/>
            </Border>

            <!-- Comparison -->
            <Border Style="{StaticResource Card}" Background="{StaticResource HeroBrush}" Margin="0,0,0,20" Visibility="{Binding HasComparison, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="Сравнение «до» и «после»" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding CompareVerdict}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,6,0,4"/>
                    <TextBlock Text="{Binding CompareTitle}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding CompareWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=⚠  {0}}" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,8,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Показатель" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Column="1" Text="До" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Column="2" Text="После" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Column="3" Text="Изменение" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Column="4" Text="Итог" Style="{StaticResource Muted}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Comparison}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Before}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding After}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Delta}" Foreground="{Binding Verdict, Converter={StaticResource VerdictBrush}}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="4" Text="{Binding VerdictText}" Foreground="{Binding Verdict, Converter={StaticResource VerdictBrush}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Разница меньше 3% считается погрешностью измерения. Сравнивайте одинаковые сцены и похожую длительность." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Trend -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding HasTrend, Converter={StaticResource Visible}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Динамика производительности" Style="{StaticResource H3}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="8" Height="8" Fill="{Binding TrendAvg.Brush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Средний FPS" Style="{StaticResource Muted}" Margin="0,0,14,0"/>
                            <Ellipse Width="8" Height="8" Fill="{Binding TrendLow.Brush}" Margin="0,0,6,0"/>
                            <TextBlock Text="1% Low" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Grid>
                    <c:LiveChart Series="{Binding TrendChart}" Height="150" Margin="0,12,0,0" Smooth="False"/>
                    <TextBlock Text="Каждая точка — отдельная сессия, от старых к новым." Style="{StaticResource Muted}" FontSize="12" Margin="34,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Empty -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <TextBlock Text="Сессий пока нет. Они появятся здесь после первой записанной игры." Style="{StaticResource Body}"/>
            </Border>

            <!-- Rows -->
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Выбрать для сравнения"/>
                                <Ellipse Grid.Column="1" Width="10" Height="10" Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Session.GameName}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Tags}" Foreground="{StaticResource AccentLightBrush}" Margin="12,2,0,0" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                        <Run Text="{Binding Date, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Duration, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Diagnosis, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Fps}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="ср. FPS" Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Low}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="1% low" Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Score}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="оценка" Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Ghost}" Content="Отчёт" Margin="0,0,8,0"
                                            Command="{Binding DataContext.OpenCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource RoundIcon}" ToolTip="Удалить сессию"
                                            Command="{Binding DataContext.DeleteCommand, ElementName=Self}" CommandParameter="{Binding}">
                                        <c:IconView Data="{StaticResource IconTrash}" Width="16" Height="16" Foreground="{StaticResource MutedBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
