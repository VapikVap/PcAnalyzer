<Window x:Class="PcAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PcAnalyzer.App.Controls"
        xmlns:vm="clr-namespace:PcAnalyzer.App.ViewModels"
        Title="PC Performance Analyzer" Width="1440" Height="920" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource TextFont}" FontSize="14" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        WindowStyle="None" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Rectangle Fill="{StaticResource WindowGlowBrush}" IsHitTestVisible="False"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Sidebar ================= -->
            <Border Margin="10" CornerRadius="24" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid Margin="20,26,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,34">
                        <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3D74FF" Offset="0"/>
                                    <GradientStop Color="#141A3A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <c:IconView Data="{StaticResource IconActivity}" Width="20" Height="20" StrokeThickness="2"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PC ANALYZER" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" FontStyle="Italic" FontSize="20"/>
                            <TextBlock Text="Performance diagnostics" Style="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource IconHome}" Content="Главная"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Dashboard}"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource IconRecord}" Content="Игровая сессия"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Session}"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource IconAnalyze}" Content="Анализ"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Analysis}"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource IconHistory}" Content="История"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=History}"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource IconPc}" Content="Мой ПК"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=MyPc}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <!-- Update available (GitHub Releases) -->
                        <Border CornerRadius="16" Background="#1A3D74FF" BorderBrush="#663D74FF" BorderThickness="1" Padding="14,12" Margin="0,0,0,12"
                                Visibility="{Binding HasUpdate, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <c:IconView Data="{StaticResource IconDownload}" Foreground="{StaticResource AccentLightBrush}" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding UpdateStatus}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Cursor="Hand" ToolTip="Открыть страницу релиза на GitHub">
                                            <Hyperlink Command="{Binding OpenReleasePageCommand}" Foreground="{StaticResource MutedBrush}" TextDecorations="None">
                                                <Run Text="{Binding CurrentVersionText, Mode=OneWay}"/><Run Text=" · что нового"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding UpdateProgress}" Margin="0,0,0,10"
                                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource RaisedBrush}" BorderThickness="0"
                                             Visibility="{Binding IsUpdating, Converter={StaticResource Visible}}"/>
                                <Button Style="{StaticResource Primary}" Content="Обновить" Padding="14,9" Command="{Binding InstallUpdateCommand}"/>
                            </StackPanel>
                        </Border>
                        <!-- Recording indicator -->
                        <Border CornerRadius="16" Background="#1AFF5A5F" BorderBrush="#40FF5A5F" BorderThickness="1" Padding="14,12" Margin="0,0,0,12"
                                Visibility="{Binding IsRecording, Converter={StaticResource Visible}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource BadBrush}" Margin="2,0,12,0">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Идёт запись" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding RecordingText}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border CornerRadius="18" Background="{StaticResource CardBrush}" Padding="6">
                            <StackPanel>
                                <Border Padding="14,10" Visibility="{Binding Telemetry.IsElevated, Converter={StaticResource Hidden}}" ToolTip="Без прав администратора недоступны температура CPU и PresentMon (FPS). Перезапуск — на странице «Игровая сессия» или в настройках.">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconView Data="{StaticResource IconShield}" Foreground="{StaticResource WarnBrush}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Ограниченный режим" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource IconSettings}" Content="Настройки" Margin="0"
                                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Content ================= -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0,44,0,0" Focusable="False"/>
        </Grid>

        <!-- Caption buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="Свернуть">
                <c:IconView Data="{StaticResource IconMinimize}" Width="14" Height="14" StrokeThickness="1.3"/>
            </Button>
            <Button Style="{StaticResource ChromeButton}" Click="OnMaximize" ToolTip="Развернуть">
                <c:IconView Data="{StaticResource IconMaximize}" Width="13" Height="13" StrokeThickness="1.3"/>
            </Button>
            <Button Style="{StaticResource ChromeButton}" Click="OnClose" ToolTip="Закрыть">
                <c:IconView Data="{StaticResource IconClose}" Width="14" Height="14" StrokeThickness="1.3"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
