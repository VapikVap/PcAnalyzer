<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Color x:Key="BgColor">#08090C</Color>
    <Color x:Key="AccentColor">#3D74FF</Color>
    <Color x:Key="AccentLightColor">#5B9BFF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#08090C"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0E0F13"/>
    <SolidColorBrush x:Key="CardBrush" Color="#101116"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#15171D"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#1A1C23"/>
    <SolidColorBrush x:Key="RaisedHoverBrush" Color="#23262F"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#1D1F27"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2A2D37"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1F2F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B4B8C3"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#7C818E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3D74FF"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#5B9BFF"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#2BD08F"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FFB547"/>
    <SolidColorBrush x:Key="MajorBrush" Color="#FF8A47"/>
    <SolidColorBrush x:Key="BadBrush" Color="#FF5A5F"/>
    <SolidColorBrush x:Key="NavActiveBrush" Color="#23252D"/>

    <!-- Blue glow at the bottom of gauge cards -->
    <RadialGradientBrush x:Key="CardGlowBrush" Center="0.5,1.05" GradientOrigin="0.5,1.05" RadiusX="0.42" RadiusY="0.55">
        <GradientStop Color="#C02A55FF" Offset="0"/>
        <GradientStop Color="#40203CC8" Offset="0.55"/>
        <GradientStop Color="#00101116" Offset="1"/>
    </RadialGradientBrush>

    <!-- Window background: soft blue light from the lower-left like the reference -->
    <RadialGradientBrush x:Key="WindowGlowBrush" Center="0.05,0.65" GradientOrigin="0.05,0.65" RadiusX="0.45" RadiusY="0.7">
        <GradientStop Color="#3A1A3BD6" Offset="0"/>
        <GradientStop Color="#0008090C" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#16203F" Offset="0"/>
        <GradientStop Color="#101116" Offset="0.7"/>
    </LinearGradientBrush>
</ResourceDictionary>
